{
  "name": "deer-flow-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev --turbo",
    "dev:fast": "dotenv -e ../.env -- next dev --turbo --experimental-https",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build",
    "build:fast": "NODE_OPTIONS='--max-old-space-size=4096' next build --no-lint",
    "build:profile": "NODE_OPTIONS='--max-old-space-size=4096' next build --profile",
    "start": "next start",
    "preview": "pnpm build && next start",
    "lint": "next lint --cache --cache-location .next/cache/eslint",
    "lint:fix": "next lint --fix --cache --cache-location .next/cache/eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "clean": "rm -rf .next node_modules/.cache",
    "analyze": "ANALYZE=true pnpm build"
  },
